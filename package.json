{
  "name": "dsh-skin-market",
  "version": "0.1.81",
  "description": "Native skin marketplace and lifecycle manager for DeepSeek Harness",
  "homepage": "https://kingofsoysauce.github.io/dsh-skin-market/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingOfSoySauce/dsh-skin-market.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-skin-market-reset": "lib/reset-cli.js",
    "dsh-skin-market-repair": "lib/repair-cli.js"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "scripts": {
    "dev": "vite --config vite.preview.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "registry": "node scripts/build-registry.mjs && node scripts/build-star-curves.mjs",
    "stars:curves": "node scripts/build-star-curves.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "registry:identity": "node scripts/check-loader-identity.mjs --all",
    "stars:record": "node scripts/record-stars.mjs",
    "hydrate": "node scripts/hydrate-submission.mjs",
    "media:build": "node scripts/build-media.mjs",
    "media:check": "node scripts/check-media.mjs",
    "smoke:submission": "vitest run tests/submission.spec.ts tests/client/client-recovery.spec.tsx tests/client/client-market.spec.tsx tests/client/client-install.spec.tsx tests/client/client-discovery.spec.tsx tests/client/client-restart.spec.tsx tests/client/client-selection.spec.tsx tests/client/client-operations.spec.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.site.json --noEmit",
    "build:host": "tsc -p tsconfig.json && chmod +x lib/reset-cli.js lib/repair-cli.js",
    "build:client": "tsdown",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run registry && npm run build:host && npm run build:client",
    "test": "vitest run",
    "check": "npm run registry && npm run typecheck && npm run test && npm run build && npm run build:site && node scripts/preflight.mjs",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "data/catalog.json",
    "registry",
    "cordis.patch.yml",
    "README.md",
    "TESTING.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@primer/octicons-react": "^19.33.0",
    "ajv": "^8.17.1",
    "undici": "^7.30.1",
    "yaml": "^2.8.1"
  }
}
