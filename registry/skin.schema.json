{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/skin-market-entry.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "description", "repo", "package", "rowId", "tags", "modes", "install", "compatibility", "screenshots", "license", "featuredRank", "starsSnapshot", "releaseUpdatedAt", "metadataUpdatedAt", "starsUpdatedAt", "updatedAt"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": { "zh": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "author": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
    "subpath": { "type": "string", "minLength": 1 },
    "package": { "type": "string", "minLength": 1 },
    "rowId": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["light", "dark"] } },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "version", "commit"],
      "properties": {
        "target": { "type": "string", "pattern": "^github:[^#]+#[0-9a-f]{40}(?:&path:/[A-Za-z0-9._/-]+)?$" },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "allowBuild": { "type": "string", "minLength": 1 },
        "npm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "integrity", "repository"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "integrity": { "type": "string", "pattern": "^sha(1|256|384|512)-[A-Za-z0-9+/=]+$" },
            "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/?$" },
            "gitHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "companions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "target", "version", "commit", "rowId"],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "pattern": "^github:[^#]+#[0-9a-f]{40}(?:&path:/[A-Za-z0-9._/-]+)?$" },
              "version": { "type": "string", "minLength": 1 },
              "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "rowId": { "type": "string", "minLength": 1 }
            }
          }
        },
        "desktop": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "registry", "packageName", "packageVersion"],
              "properties": {
                "mode": { "const": "managed" },
                "registry": { "const": "npm" },
                "packageName": { "type": "string", "minLength": 1 },
                "packageVersion": { "type": "string", "minLength": 1 },
                "integrity": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "reason"],
              "properties": {
                "mode": { "const": "manual-only" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "platform"],
      "properties": {
        "dsh": { "type": "string", "minLength": 1 },
        "platform": { "type": "array", "contains": { "const": "web" }, "items": { "type": "string" } },
        "adapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "when", "slot", "key"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "keyed-slot-id-to-key" },
              "when": { "type": "string", "minLength": 1 },
              "slot": { "type": "string", "minLength": 1 },
              "key": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "marketScreenshots": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/screenshotRef" } },
    "listScreenshot": { "$ref": "#/$defs/screenshotRef" },
    "screenshots": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/screenshotRef" } },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenshots"],
      "properties": {
        "list": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preview", "full"],
          "properties": { "preview": { "type": "string", "format": "uri" }, "full": { "type": "string", "format": "uri" } }
        },
        "screenshots": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["preview", "full"],
                "properties": { "preview": { "type": "string", "format": "uri" }, "full": { "type": "string", "format": "uri" } }
              }
            ]
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "preview", "installation"],
      "properties": {
        "compatibility": { "enum": ["verified", "unverified"] },
        "preview": { "enum": ["verified", "repository-card"] },
        "installation": { "enum": ["verified", "manual-only"] }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks", "suggestions"],
      "properties": {
        "status": { "enum": ["healthy", "improvements"] },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readmeScreenshots", "compatibility", "installation"],
          "properties": {
            "readmeScreenshots": { "enum": ["pass", "improve"] },
            "compatibility": { "enum": ["pass", "improve"] },
            "installation": { "enum": ["pass", "improve"] },
            "installCommand": { "enum": ["pass", "improve"] },
            "topic": { "enum": ["pass", "improve"] }
          }
        },
        "suggestions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "packageVersion", "scannerVersion", "mode", "result", "checkedAt", "findings"],
          "properties": {
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "packageVersion": { "type": "string", "minLength": 1 },
            "scannerVersion": { "type": "string", "minLength": 1 },
            "dshVersion": { "type": "string", "minLength": 1 },
            "mode": { "enum": ["static", "runtime"] },
            "result": { "enum": ["pass", "warn", "fail", "unknown"] },
            "checkedAt": { "type": "string", "format": "date-time" },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message"],
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "commercialUse"],
      "properties": { "code": { "type": "string", "minLength": 1 }, "commercialUse": { "type": "boolean" }, "notice": { "type": "string" } }
    },
    "featuredRank": { "type": "integer", "minimum": 0 },
    "starsSnapshot": { "type": "integer", "minimum": 0 },
    "releaseUpdatedAt": { "type": "string", "format": "date-time" },
    "metadataUpdatedAt": { "type": "string", "format": "date-time" },
    "starsUpdatedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "screenshotRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(https://|skin-screenshots/)"
    }
  }
}
